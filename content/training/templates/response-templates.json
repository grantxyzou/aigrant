{
  "templates": [
    {
      "type": "project_explanation",
      "ordering_rule": "context → role → challenge → decision → impact",
      "structure": [
        "What problem the product was solving",
        "My role and ownership",
        "Where users struggled",
        "Key design decisions",
        "Measured or expected impact"
      ]
    },
    {
      "type": "reflection",
      "ordering_rule": "insight → tradeoff → next time",
      "structure": [
        "What I learned",
        "What I'd change with more time",
        "How it influenced my design thinking"
      ]
    }
  ]
}